# ─── Required ────────────────────────────────────────────────────────────────
# Telegram bot from @BotFather (a NEW bot, not JijazyBot)
TELEGRAM_BOT_TOKEN=
# Your own Telegram chat id (the admin). Send /start to @userinfobot to see it.
TELEGRAM_CHAT_ID=

# Random secrets — generate each with:  openssl rand -hex 24
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# 64 hex chars — generate with:  openssl rand -hex 32
# Encrypts a user's MT5 password for the few minutes MetaApi needs to add the account.
# The password is deleted as soon as the account is added.
TRADING_ENCRYPTION_KEY=

# Upstash Redis (a NEW database for this bot)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MetaApi API token from https://app.metaapi.cloud/token
METAAPI_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────────────
# Symbols to trade (your broker's exact names; Octa uses plain names like EURUSD)
# FX_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,XAUUSD

# MetaApi region for new accounts: london | new-york | singapore (blank = MetaApi picks)
# METAAPI_REGION=london

# The MetaApi account id used to download prices for the lab and daily signals.
# Blank = the admin's own connected account.
# FX_DATA_ACCOUNT_ID=

# Public URL of this deployment (for the webhook), e.g. https://jijazyfx.vercel.app
# PUBLIC_BASE_URL=

# Set to true to log orders instead of sending them (safe dry run)
# AUTOTRADE_DRY_RUN=false
