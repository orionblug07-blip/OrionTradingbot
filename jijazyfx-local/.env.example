# Copy this file to ".env" (same folder) and fill it in.

# ─── MetaTrader 5 ────────────────────────────────────────────────────────────
# Simplest and safest: leave these three BLANK. The bot then uses whatever
# account is logged in to your MT5 terminal (tick "Save password" when you log in).
# Fill them only if you want the bot to log in by itself.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Only needed if the bot can't find MT5 by itself, e.g.
# MT5_PATH=C:\Program Files\OctaFX MetaTrader 5\terminal64.exe
MT5_PATH=

# ─── Telegram (the same bot as before) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Optional ────────────────────────────────────────────────────────────────
# Symbols, exactly as they appear in MT5's Market Watch
# FX_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,XAUUSD

# Minutes to wait after a new daily candle opens before trading it
# (spreads are very wide right at the broker's rollover)
# WAIT_AFTER_DAILY_OPEN_MIN=60

# true = report what it would do, but send no orders
# AUTOTRADE_DRY_RUN=false
